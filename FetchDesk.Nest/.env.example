# Server
NODE_ENV=production
PORT=8080

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fetchdesk_db
DATABASE_USER=fetchdesk_user
DATABASE_PASSWORD=your_secure_password

# RabbitMQ
RABBITMQ_URL=amqps://user:password@hostname:5671/vhost

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app

# Optional: API URL for internal communication
API_URL=https://fetchdesk-nest.onrender.com
